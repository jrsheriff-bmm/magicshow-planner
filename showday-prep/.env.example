# .env.example — copy this file to a new file named ".env" and fill in real values.
# The .env file holds secrets. It is listed in .gitignore so it NEVER goes to GitHub.

# A long random string Django uses to sign logins. Make a new one for production:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

# True on your computer, False online. Never leave True on the live site.
DEBUG=True

# Web addresses this site answers to, separated by commas.
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave blank on your computer to use a simple file database (db.sqlite3).
# Online, Render fills this in with the Postgres address automatically.
DATABASE_URL=

# Your Claude API key from console.anthropic.com. Only used by the Reports page's
# "AI status summary". Leave blank to keep AI off.
ANTHROPIC_API_KEY=
# Which Claude model writes it. Check docs.claude.com for current names.
CLAUDE_MODEL=claude-sonnet-5

# (v3) The site's full address, used for the links inside emails ("Mark done", "Approve").
# On your computer: http://localhost:8000   Online: your real address, e.g. https://prep.blackmagicmedia.com
SITE_URL=http://localhost:8000

# Email for reminder emails. Leave blank on your computer: emails print in the terminal instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MagicShow <no-reply@example.com>

# (final) Who can create an account at /signup/. With both lines left as they are, anyone can.
# ALLOW_SIGNUP=False closes sign-up (accounts are then made in /admin/).
# SIGNUP_CODE=some-word keeps it open only for people who know that code.
ALLOW_SIGNUP=True
SIGNUP_CODE=

# On your own server (not Render), set this to True once https works, so the site
# always uses https and secure cookies. See docs/09-run-on-your-own-server.md.
SECURE_SSL=False

# Optional: store uploaded files in Cloudflare R2 or Amazon S3 instead of the server's disk.
# Set USE_S3=True and fill in the rest. See docs/03-put-it-online.md.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
